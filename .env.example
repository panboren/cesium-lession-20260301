# 应用标题
VITE_APP_TITLE=Cesium GIS Platform

# 基础路径
VITE_BASE_PATH=/

# 端口
VITE_PORT=5173

# 是否自动打开浏览器
VITE_OPEN=true

# 输出目录
VITE_OUT_DIR=dist

# 是否生成 sourceMap（生产环境设为 false）
VITE_SOURCEMAP=false

# 是否移除 console（生产环境设为 true）
VITE_DROP_CONSOLE=false

# Cesium Ion 访问令牌（用于访问 Cesium Ion 服务，如地形、3D 模型等）
# 获取方式：访问 https://cesium.com/ion/tokens 创建免费账户并创建令牌
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
