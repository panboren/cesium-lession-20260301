# Cesium 配置

# Cesium Ion 访问令牌 (可选，用于访问 Cesium Ion 服务)
# 申请地址: https://cesium.com/ion/tokens
# 请在此处填入您自己的 Token
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN_HERE

# Cesium 资源基础路径
VITE_CESIUM_BASE_PATH=./cesium/

# 默认地图服务
VITE_DEFAULT_IMAGERY_PROVIDER=gaode
VITE_DEFAULT_TERRAIN_PROVIDER=arcgis

# 地图中心点
VITE_DEFAULT_LONGITUDE=116.3912
VITE_DEFAULT_LATITUDE=39.9075
VITE_DEFAULT_HEIGHT=10000

# 性能配置
VITE_REQUEST_RENDER_MODE=true
VITE_TARGET_FRAME_RATE=60
