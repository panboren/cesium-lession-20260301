{
  "name": "cesium-gis-platform",
  "private": true,
  "version": "2.0.0",
  "description": "现代化 Cesium 3D GIS 平台 - 基于 Vue3 + TypeScript + Cesium",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,vue,css,scss,html,json}",
    "format:check": "prettier --check src/**/*.{ts,tsx,js,jsx,vue,css,scss,html,json}",
    "type-check": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@turf/turf": "^7.1.0",
    "@vueuse/core": "^12.2.0",
    "axios": "^1.13.6",
    "cesium": "^1.114.0",
    "dayjs": "^1.11.19",
    "element-plus": "^2.9.1",
    "lodash-es": "^4.17.23",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "proj4": "^2.12.1",
    "screenfull": "^6.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.83.4",
    "typescript": "~5.6.3",
    "unocss": "^0.65.0",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.3",
    "vite-plugin-cesium": "^1.2.19",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^2.1.10"
  }
}
